{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": true,
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/192-168-1-1.html",
      "destination": "/ip/192-168-1-1/",
      "permanent": true
    },
    {
      "source": "/192-168-0-1.html",
      "destination": "/ip/192-168-0-1/",
      "permanent": true
    },
    {
      "source": "/10-0-0-1.html",
      "destination": "/ip/10-0-0-1/",
      "permanent": true
    },
    {
      "source": "/192-168-1-254.html",
      "destination": "/ip/192-168-1-254/",
      "permanent": true
    },
    {
      "source": "/192-168-2-1.html",
      "destination": "/ip/192-168-2-1/",
      "permanent": true
    },
    {
      "source": "/192-168-8-1.html",
      "destination": "/ip/192-168-8-1/",
      "permanent": true
    },
    {
      "source": "/192-168-10-1.html",
      "destination": "/ip/192-168-10-1/",
      "permanent": true
    },
    {
      "source": "/192-168-11-1.html",
      "destination": "/ip/192-168-11-1/",
      "permanent": true
    },
    {
      "source": "/192-168-12-1.html",
      "destination": "/ip/192-168-12-1/",
      "permanent": true
    },
    {
      "source": "/192-168-31-1.html",
      "destination": "/ip/192-168-31-1/",
      "permanent": true
    },
    {
      "source": "/192-168-88-1.html",
      "destination": "/ip/192-168-88-1/",
      "permanent": true
    },
    {
      "source": "/192-168-100-1.html",
      "destination": "/ip/192-168-100-1/",
      "permanent": true
    },
    {
      "source": "/10-0-1-1.html",
      "destination": "/ip/10-0-1-1/",
      "permanent": true
    },
    {
      "source": "/192-168-1-2.html",
      "destination": "/ip/192-168-1-2/",
      "permanent": true
    },
    {
      "source": "/brands.html",
      "destination": "/brands/",
      "permanent": true
    },
    {
      "source": "/tools.html",
      "destination": "/tools/",
      "permanent": true
    },
    {
      "source": "/brand/:brand",
      "destination": "/brands/:brand/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}